{
  "manifest_version": 3,
  "name": "FocusOS — Pomodoro & Deep Work Timer",
  "short_name": "FocusOS",
  "description": "An offline-first Pomodoro workspace in your toolbar: timer, tasks, analytics and ambient focus, all stored on your device.",
  "version": "0.0.0",
  "homepage_url": "https://focusos.pro",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "FocusOS",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "permissions": ["storage", "alarms", "notifications"],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+F" },
      "description": "Open the FocusOS popup"
    },
    "toggle-timer": {
      "suggested_key": { "default": "Alt+Shift+P" },
      "description": "Start, pause or resume the timer"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "focusos@focusos.pro",
      "strict_min_version": "121.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
